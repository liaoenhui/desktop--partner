    { "id": "evening", "time": "22:00", "action": "yawn", "lines": ["十点了。手头的任务收个尾，别又拖到半夜。"] },
    { "id": "midnight", "time": "00:00", "action": "yawn", "lines": ["还不睡，准备和我通宵打游戏吗？……算了，先存档，明天再来。"] }
