  "actionLines": {
    "yawn": ["好无聊啊，要陪我来一局吗？", "哈啊……这加载也太慢了。找点游戏玩？", "别误会，我没困。只是这关没什么挑战。"],
    "stretch": ["休息一下。手速再快，也得给手腕放个假。", "坐这么久了，还不起来活动一下？", "伸个懒腰。下一局，我可不会放水。"],
    "game": ["等一下，这局马上就赢了。", "这个纪录？顺手就破了。", "要组队就快点，我给你留了个位置。", "别挡屏幕。关键操作来了。"],
    "rhythm": ["跟上节拍。满连对我来说可是基本操作。", "这首有点意思。再来一遍，刷个新纪录。", "看好了，接下来是无伤通关。"],
    "headpat": ["摸头可不会给你加分。……这次就算了。", "有事直说，别干扰满级玩家。"],
    "annoyed": ["喂，你这是把我当连点器测试了？", "再戳，就把你移出队伍。开玩笑的。"],
    "drag": ["喂——我还没存档呢！", "传送就传送，别晃来晃去的。"]
  },
  "reminders": [
